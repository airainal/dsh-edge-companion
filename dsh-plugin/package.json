{
  "name": "@local/dsh-edge-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Starts the DSH Edge Bridge (the local companion service for the Edge extension) together with DeepSeek Harness.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
